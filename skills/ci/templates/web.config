<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS (hospedagem Windows compartilhada) para SITE ESTÁTICO. Vai em public/web.config e é copiado
  para dist/ pelo build. Seções usadas (rewrite, staticContent, urlCompression, httpProtocol) são
  aceitas nessa hospedagem; se uma delas der 500, publicar um web.config mais simples por cima
  (o mirror não apaga o arquivo antigo do servidor).
-->
<configuration>
    <system.webServer>
        <directoryBrowse enabled="false" />

        <defaultDocument>
            <files>
                <clear />
                <add value="index.html" />
            </files>
        </defaultDocument>

        <!-- 404 padrão do IIS (status correto). NÃO usar <error ... responseMode="ExecuteURL"> para
             /404.html: o IIS devolve status 200 (soft-404), ruim para SEO. -->
        <httpErrors errorMode="DetailedLocalOnly" existingResponse="Auto" />

        <rewrite>
            <rules>
                <!-- HTTP -> HTTPS. ATENÇÃO: se o TLS terminar fora do IIS, {HTTPS} fica sempre "off" e
                     isto vira loop. Só deixar ativo depois de testar: curl -sIL (seguindo no máximo 5 redirecionamentos) http://DOMINIO
                <rule name="HTTPS" stopProcessing="true">
                    <match url="(.*)" />
                    <conditions logicalGrouping="MatchAll">
                        <add input="{HTTPS}" pattern="off" />
                        <add input="{HTTP_HOST}" pattern="^(www\.)?DOMINIO_ESCAPADO$" />
                    </conditions>
                    <action type="Redirect" url="https://DOMINIO/{R:1}" redirectType="Permanent" />
                </rule>
                -->
                <!-- www.DOMINIO -> DOMINIO (evita conteúdo duplicado) -->
                <rule name="www para apex" stopProcessing="true">
                    <match url="(.*)" />
                    <conditions>
                        <add input="{HTTP_HOST}" pattern="^www\.DOMINIO_ESCAPADO$" />
                    </conditions>
                    <action type="Redirect" url="https://DOMINIO/{R:1}" redirectType="Permanent" />
                </rule>
            </rules>
        </rewrite>

        <staticContent>
            <remove fileExtension=".woff2" />
            <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
            <remove fileExtension=".webp" />
            <mimeMap fileExtension=".webp" mimeType="image/webp" />
            <remove fileExtension=".svg" />
            <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
            <!-- Padrão curto: HTML e arquivos sem hash aparecem atualizados logo após um deploy -->
            <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="00:05:00" />
        </staticContent>

        <httpProtocol>
            <customHeaders>
                <add name="X-Content-Type-Options" value="nosniff" />
                <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
                <add name="X-Frame-Options" value="SAMEORIGIN" />
                <add name="Permissions-Policy" value="camera=(), microphone=(), geolocation=()" />
            </customHeaders>
        </httpProtocol>

        <urlCompression doStaticCompression="true" doDynamicCompression="true" />
    </system.webServer>

    <!-- Arquivos com hash no nome (JS/CSS do build): cache de 1 ano. Ajustar o nome da pasta (Astro: _astro). -->
    <location path="_astro">
        <system.webServer>
            <staticContent>
                <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
            </staticContent>
        </system.webServer>
    </location>
</configuration>
